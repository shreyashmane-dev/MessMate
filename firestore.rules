rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles: Only the owner can read or write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Messes:
    // - Anyone can view mess listings
    // - Any logged-in user can create a mess
    // - Only the owner can update or delete their mess
    match /messes/{messId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    
    // Requests:
    // - Logged-in users can create requests
    // - Only the student who sent it or the mess owner can read/update it
    match /requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.ownerId
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid == resource.data.userId
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Reviews:
    // - Anyone can read reviews
    // - Only logged-in users can write reviews
    // - Only the author can delete their review
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
